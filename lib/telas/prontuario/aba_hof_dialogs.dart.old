import 'package:flutter/material.dart';
import 'package:ibn/features/auth/data/auth_service.dart';
import 'package:ibn/core/formadores.dart';
import 'package:ibn/core/hof.dart';
import 'package:ibn/core/paciente.dart';
/// Dialog para criar/editar procedimento HOF
class _DialogProcedimentoHOF extends StatefulWidget {
  final ProcedimentoHOF? procedimentoExistente;
  final void Function(ProcedimentoHOF) onSalvar;

  const _DialogProcedimentoHOF({
    this.procedimentoExistente,
    required this.onSalvar,
  });

  @override
  State<_DialogProcedimentoHOF> createState() => _DialogProcedimentoHOFState();
}

class _DialogProcedimentoHOFState extends State<_DialogProcedimentoHOF> {
  late TipoHOF _tipo;
  String? _tipoOutro;
  final _tecnicaCtrl = TextEditingController();
  final _obsCtrl = TextEditingController();
  final List<PontoAplicacaoHOF> _pontos = [];
  final List<InsumoHOF> _insumos = [];

  @override
  void initState() {
    super.initState();
    final p = widget.procedimentoExistente;
    _tipo = p?.tipo ?? TipoHOF.toxinaBotulinica;
    _tipoOutro = p?.tipoOutro;
    _tecnicaCtrl.text = p?.tecnicaGeral ?? '';
    _obsCtrl.text = p?.observacoes ?? '';
    if (p != null) {
      _pontos.addAll(p.pontos);
      _insumos.addAll(p.insumos);
    }
  }

  @override
  void dispose() {
    _tecnicaCtrl.dispose();
    _obsCtrl.dispose();
    super.dispose();
  }
}
